{
  "name": "system-loopback",
  "version": "0.1.0",
  "description": "Zero-driver cross-platform system audio loopback capture for Node.js and Electron (macOS Core Audio Tap, Windows WASAPI, Linux PipeWire/PulseAudio).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prebuilds",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangjunsen0406/system-loopback.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/huangjunsen0406/system-loopback#readme",
  "bugs": {
    "url": "https://github.com/huangjunsen0406/system-loopback/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "audio",
    "loopback",
    "electron",
    "aec",
    "coreaudio",
    "wasapi",
    "pulseaudio",
    "pipewire",
    "voice-ai"
  ],
  "license": "MIT"
}
